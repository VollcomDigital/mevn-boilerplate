{
  "name": "cloud-native-mevn-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Cloud native MEVN monorepo scaffold with Turborepo, Nuxt 4, Express 5, Strapi 5, and Helm.",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . && turbo run lint",
    "lint:fix": "eslint . --fix && turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.2",
    "@commitlint/config-conventional": "^19.6.2",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.8.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "pnpm": {
    "overrides": {
      "@casl/ability": "^6.7.5",
      "axios": "^1.13.5",
      "minimatch@<3.1.3": "^3.1.3",
      "minimatch@>=5.0.0 <5.1.7": "^5.1.7",
      "minimatch@>=9.0.0 <9.0.6": "^9.0.6",
      "minimatch@>=10.0.0 <10.2.1": "^10.2.1",
      "tar": "^7.5.8"
    }
  }
}
